# Copy to .env.local for local development, and add the same names as
# GitHub Actions variables for the Pages build. All three values are public by design:
# they are compiled into the browser code. Use the LEGACY anon key (JWT starting
# eyJ), not sb_publishable_: the functions have verify_jwt enabled. Never put a service-role key,
# SMTP password or voice-agent token here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). For local testing, Cloudflare's test key
# 1x00000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Voice receptionist demo: the Vapi PUBLIC key (never the private key), restricted in Vapi to
# https://aimsmartsolutions.tech and the "AIM Demo Receptionist" assistant, so it will not
# connect from localhost. Without these the demo button shows a "not available" message.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_DEMO_ASSISTANT_ID=
